# Credenciales de tu app en https://kick.com/settings/developer
KICK_CLIENT_ID=tu_kick_client_id
KICK_CLIENT_SECRET=tu_kick_client_secret

# URL pública HTTPS expuesta por Cloudflare Tunnel (sin barra final)
PUBLIC_BASE_URL=https://api.tuservidor.com

# Clave AES-256-GCM en Base64 que decodifique exactamente a 32 bytes
# Generar con: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=REEMPLAZA_CON_32_BYTES_EN_BASE64

# Pepper secreto (>= 16 chars) para HMAC-SHA256 de API tokens de streamers
TOKEN_HASH_PEPPER=reemplaza-con-pepper-largo-y-aleatorio

# Token de administrador (>= 32 chars) para /v1/admin/* y /admin
ADMIN_API_TOKEN=reemplaza-con-admin-token-de-al-menos-32-caracteres

# Base de datos local (SQLite). En Vercel, usa la URL PostgreSQL persistente del proveedor.
DATABASE_URL=sqlite:///./data/kickbridge.db

# Seguridad HTTP / proxy (Cloudflare Tunnel)
REQUIRE_HTTPS=true
TRUST_PROXY=true

# Tiempos y límites
LINK_TTL_SECONDS=300
LINK_TTL_MIN_SECONDS=60
LINK_TTL_MAX_SECONDS=900
CHAT_COOLDOWN_SECONDS=10
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_SECONDS=30
REPLAY_WINDOW_SECONDS=120
ACCESS_REFRESH_SKEW_SECONDS=60
LINK_START_RATE_LIMIT=5
LINK_START_RATE_WINDOW_SECONDS=600
OAUTH_IP_RATE_LIMIT=60
OAUTH_IP_RATE_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Hosts oficiales de Kick
KICK_API_BASE=https://api.kick.com
KICK_OAUTH_BASE=https://id.kick.com
